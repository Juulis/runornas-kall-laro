        "Han är arg"
      ]
    },
    {
      "id": "lf-ak2-007",
      "niva": "ak2",
      "typ": "ord",
      "text": "Ordet bleka betyder att något blir ljusare eller mattare. Himlen bleknar vid gryning. Mörkret slipper taget.",
      "fraga": "Vad betyder bleka här?",
      "ratt": "Bli ljusare eller mattare",
      "fel": [
        "Bli kallare",
        "Bli tyngre",
        "Bli snabbare"
      ]
    },
    {
      "id": "lf-ak2-008",
      "niva": "ak2",
      "typ": "vad",
      "text": "Siv bär honung i en kruka. Hon går försiktigt över bron. En droppe faller. Bin surrar nyfiket.",
      "fraga": "Vad bär Siv?",
      "ratt": "Honung i en kruka",
      "fel": [
        "Vatten i en hink",
        "Fisk i ett nät",
        "Ved i en korg"
      ]
    },
    {
      "id": "lf-ak2-009",
      "niva": "ak2",
      "typ": "ordning",
      "text": "Först ritar de en karta. Sen märker de stigen med stenar. Därefter går de tillbaka till lägret. Sist visar de kartan för de andra.",
      "fraga": "Vad gör de efter att ha märkt stigen?",
      "ratt": "Går tillbaka till lägret",
      "fel": [
        "Sover",
        "Ritar kartan",
        "Visar kartan"
      ]
    },
    {
      "id": "lf-ak2-010",
      "niva": "ak2",
      "typ": "slutsats",
      "text": "Älgen står i dimman. Den rör sig tyst. Barnen håller andan. Älgen går vidare utan att se dem.",
      "fraga": "Hur rör sig älgen?",
      "ratt": "Tyst",
      "fel": [
        "Högljutt",
        "Med sång",
        "Snabbt i språng"
      ]
    },
    {
      "id": "lf-ak2-011",
      "niva": "ak2",
      "typ": "var",
      "text": "Byarna ligger nära fjället. Röken stiger från skorstenarna. En väg slingrar uppför. Där uppe finns en utsikt.",
      "fraga": "Var finns utsikten?",
      "ratt": "Uppe vid fjället",
      "fel": [
        "Under bron",
        "I källaren",
        "I båten"
      ]
    },
    {
      "id": "lf-ak2-012",
      "niva": "ak2",
      "typ": "varfor",
      "text": "Alva övar på runtecknen. Hon skriver dem i sanden. Vågorna suddar ut dem. Hon övar igen.",
      "fraga": "Varför övar Alva igen?",
      "ratt": "Vågorna suddade ut tecknen",
      "fel": [
        "Hon är arg",
        "Hon ska simma",
        "Hon är hungrig"
      ]
    },
    {
      "id": "lf-ak2-013",
      "niva": "ak2",
      "typ": "vad",
      "text": "Nisse hittar en gammal nyckel. Den passar i en liten låda. I lådan ligger en fjäder. Fjädern glänser mjukt.",
      "fraga": "Vad ligger i lådan?",
      "ratt": "En fjäder",
      "fel": [
        "En yxa",
        "En sten",
        "En fisk"
      ]
    },
    {
      "id": "lf-ak2-014",
      "niva": "ak2",
      "typ": "ord",
      "text": "Ordet slingra betyder att något går i bågar. Vägen slingrar mellan träden. Den är inte rak.",
      "fraga": "Vad betyder slingra?",
      "ratt": "Gå i bågar",
      "fel": [
        "Gå baklänges",
        "Gå rakt",
        "Gå fort"
      ]
    },
    {
      "id": "lf-ak2-015",
      "niva": "ak2",
      "typ": "vem",
      "text": "Harald ger vatten till hästen. Sen borstar han manen. Hästen står stilla. Den litar på honom.",
      "fraga": "Vem litar hästen på?",
      "ratt": "Harald",
      "fel": [
        "Björnen",
        "Ugglan",
        "Månen"
      ]
    },
    {
      "id": "lf-ak2-016",
      "niva": "ak2",
      "typ": "varfor",
      "text": "Det regnar lätt. De sätter upp ett tält. Elden skyddas med stenar. Alla håller sig torra.",
      "fraga": "Varför sätter de upp tält?",
      "ratt": "Det regnar",
      "fel": [
        "Det är soligt",
        "De ska fiska",
        "De ska dansa"
      ]
    },
    {
      "id": "lf-ak2-017",
      "niva": "ak2",
      "typ": "ordning",
      "text": "Först samlar de bär. Sen kokar de dem till sylt. Därefter fyller de burkar. Sist ställer de burkarna svalt.",
      "fraga": "Vad gör de precis innan burkarna ställs svalt?",
      "ratt": "Fyller burkarna",
      "fel": [
        "Äter",
        "Samlar bär",
        "Kokar sylt"
      ]
    },
    {
      "id": "lf-ak2-018",
      "niva": "ak2",
      "typ": "slutsats",
      "text": "Månen speglas i sjön. Vinden är svag. En uggla ropar. Natten känns lugn.",
      "fraga": "Hur känns natten?",
      "ratt": "Lugn",
      "fel": [
        "Högljudd",
        "Het",
        "Läskig"
      ]
    },
    {
      "id": "lf-ak2-019",
      "niva": "ak2",
      "typ": "var",
      "text": "Ida följer spår i snön. Spåren leder till en håla. Där inne sover en björnunge. Ida går tyst därifrån.",
      "fraga": "Var sover björnungen?",
      "ratt": "I en håla",
      "fel": [
        "På taket",
        "I båten",
        "I trädet"
      ]
    },
    {
      "id": "lf-ak2-020",
      "niva": "ak2",
      "typ": "vad",
      "text": "Tor berättar en saga. Alla lyssnar. Elden sprakar. Sagaordet känns nära.",
      "fraga": "Vad gör Tor?",
      "ratt": "Berättar en saga",
      "fel": [
        "Fiskar",
        "Bygger hus",
        "Sover"
      ]
    },
    {
      "id": "lf-ak2-021",
      "niva": "ak2",
      "typ": "ord",
      "text": "Ordet svalt betyder lite kallt. Maten håller sig bättre där. Burkarna står i skuggan.",
      "fraga": "Vad betyder svalt?",
      "ratt": "Lite kallt",
      "fel": [
        "Mycket blött",
        "Mycket mörkt",
        "Mycket hett"
      ]
    },
    {
      "id": "lf-ak2-022",
      "niva": "ak2",
      "typ": "vem",
      "text": "Mira och Bo leker kull. De springer mellan träden. Bo tappar hatten. Mira ger tillbaka den.",
      "fraga": "Vem tappar hatten?",
      "ratt": "Bo",
      "fel": [
        "Älvan",
        "Tor",
        "Mira"
      ]
    },
    {
      "id": "lf-ak2-023",
      "niva": "ak2",
      "typ": "varfor",
      "text": "Stigen är lerig efter regnet. De går försiktigt. Ingen vill halka. De håller i varandra.",
      "fraga": "Varför går de försiktigt?",
      "ratt": "Stigen är lerig",
      "fel": [
        "Stigen är torr",
        "De är hungriga",
        "De ska sova"
      ]
    },
    {
      "id": "lf-ak2-024",
      "niva": "ak2",
      "typ": "ordning",
      "text": "Först öppnar de porten. Sen går de in i gården. Där möter dem en vänlig hund. Sist får de soppa.",
      "fraga": "Vad möter dem i gården?",
      "ratt": "En vänlig hund",
      "fel": [
        "En storm",
        "En båt",
        "En björn"
      ]
    },
    {
      "id": "lf-ak2-025",
      "niva": "ak2",
      "typ": "slutsats",
      "text": "Fåglarna flyger söderut. Det börjar bli kallt. Löven faller. Vintern närmar sig.",
      "fraga": "Vilken årstid närmar sig?",
      "ratt": "Vintern",
      "fel": [
        "Våren",
        "Sommaren",
        "Högsommar"
      ]
    },
    {
      "id": "lf-ak2-026",
      "niva": "ak2",
      "typ": "vad",
      "text": "Siv lägger en sten på stigen. Den visar vägen tillbaka. Andra vandrare kan följa den. Stenen är målad blå.",
      "fraga": "Vad visar den blå stenen?",
      "ratt": "Vägen tillbaka",
      "fel": [
        "Vägen till månen",
        "Vägen till havsbotten",
        "Vägen till taket"
      ]
    },
    {
      "id": "lf-ak2-027",
      "niva": "ak2",
      "typ": "var",
      "text": "Ån rinner kraftigare efter regnet. Bron darrar lite. De går en och en. Alla kommer säkert över.",
      "fraga": "Var går de en och en?",
      "ratt": "Över bron",
      "fel": [
        "I båten",
        "På taket",
        "I skogen"
      ]
    },
    {
      "id": "lf-ak2-028",
      "niva": "ak2",
      "typ": "ord",
      "text": "Ordet darrar betyder att något skakar lite. Bron darrar. De känner det under fötterna.",
      "fraga": "Vad betyder darrar?",
      "ratt": "Skakar lite",
      "fel": [
        "Sjunger",
        "Lyser starkt",
        "Luktar gott"
      ]
    },
    {
      "id": "lf-ak2-029",
      "niva": "ak2",
      "typ": "slutsats",
      "text": "Elin delar sitt bröd. Den hungriga räven tar emot det. Elin ler. De skiljs som vänner.",
      "fraga": "Hur skiljs Elin och räven?",
      "ratt": "Som vänner",
      "fel": [
