        "Ugglan",
        "Månen"
      ]
    },
    {
      "id": "lf-ak1-032",
      "niva": "ak1",
      "typ": "varfor",
      "text": "Det blåser kallt. De knyter kapperna. Sen går de vidare.",
      "fraga": "Varför knyter de kapperna?",
      "ratt": "Det blåser kallt",
      "fel": [
        "Det är varmt",
        "De ska sova",
        "De ska simma"
      ]
    },
    {
      "id": "lf-ak2-001",
      "niva": "ak2",
      "typ": "vad",
      "text": "Elin vandrar längs ån. Hon ser en rund sten med en runa. Runan lyser blekt blått. Elin stannar och lyssnar.",
      "fraga": "Vad lyser blekt blått?",
      "ratt": "Runan",
      "fel": [
        "Ån",
        "Stigen",
        "Skogen"
      ]
    },
    {
      "id": "lf-ak2-002",
      "niva": "ak2",
      "typ": "ordning",
      "text": "Bo bakar knäckebröd. Mira hämtar vatten. Tor tänder elden. Sen äter alla tillsammans.",
      "fraga": "Vad händer sist?",
      "ratt": "Alla äter tillsammans",
      "fel": [
        "Mira hämtar vatten",
        "Tor tänder elden",
        "Bo bakar"
      ]
    },
    {
      "id": "lf-ak2-003",
      "niva": "ak2",
      "typ": "vem",
      "text": "En liten räv följer stigen. Den luktar rök från lägret. Räven vågar sig närmare. Barnen ger den en bit bröd.",
      "fraga": "Vem ger räven bröd?",
      "ratt": "Barnen",
      "fel": [
        "Elden",
        "Räven",
        "Stenen"
      ]
    },
    {
      "id": "lf-ak2-004",
      "niva": "ak2",
      "typ": "varfor",
      "text": "Det börjar skymma. Tor tänder lyktan för att se stigen. Vinden är kall. De skyndar mot byn.",
      "fraga": "Varför tänder Tor lyktan?",
      "ratt": "För att se stigen",
      "fel": [
        "För att sova",
        "För att laga mat",
        "För att fiska"
      ]
    },
    {
      "id": "lf-ak2-005",
      "niva": "ak2",
      "typ": "var",
      "text": "Gläntan ligger mellan höga granar. Solen når marken där. Blommor växer runt en gammal stubbe. En älva sitter där och vilar.",
      "fraga": "Var sitter älvan?",
      "ratt": "Vid stubben i gläntan",
      "fel": [
        "I snön",
        "På taket",
        "I båten"
      ]
    },
    {
      "id": "lf-ak2-006",
      "niva": "ak2",
      "typ": "slutsats",
      "text": "Hugo har gått långt. Fötterna värker. Han sätter sig vid en sten. Snart somnar han en stund.",
      "fraga": "Varför somnar Hugo?",
      "ratt": "Han är trött efter vandringen",
      "fel": [
        "Han fryser av snö",
