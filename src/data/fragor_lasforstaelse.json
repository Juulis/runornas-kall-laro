        "Som grannar",
        "Som fiender"
      ]
    },
    {
      "id": "lf-ak2-030",
      "niva": "ak2",
      "typ": "vad",
      "text": "Hugo räknar stjärnor. Han kommer till tio. Sen somnar han. Drömmen är ljus.",
      "fraga": "Hur många stjärnor räknar Hugo till?",
      "ratt": "Tio",
      "fel": [
        "Hundra",
        "Två",
        "Noll"
      ]
    },
    {
      "id": "lf-ak2-031",
      "niva": "ak2",
      "typ": "var",
      "text": "Byborna samlas vid elden. De delar nyheter. Barnen lyssnar. Kvällen blir lång och varm.",
      "fraga": "Var samlas byborna?",
      "ratt": "Vid elden",
      "fel": [
        "På taket",
        "I sjön",
        "I grottan"
      ]
    },
    {
      "id": "lf-ak2-032",
      "niva": "ak2",
      "typ": "varfor",
      "text": "Det snöar tätare. De skyndar till stugan. Inne brinner elden. Utanför vitnar världen.",
      "fraga": "Varför skyndar de till stugan?",
      "ratt": "Det snöar tätare",
      "fel": [
        "De ska simma",
        "De ska fiska",
        "Det är sommar"
      ]
    },
    {
      "id": "lf-ak3-001",
      "niva": "ak3",
      "typ": "vad",
      "text": "Elin följer ån mot gläntan. Där ligger en sten med tre runor. Den mittersta runan lyser starkare än de andra. Elin ritar av tecknen i sanden. Sen går hon tillbaka till lägret för att visa dem.",
      "fraga": "Vilken runa lyser starkast?",
      "ratt": "Den mittersta",
      "fel": [
        "Den första",
        "Ingen av dem",
        "Den sista"
      ]
    },
    {
      "id": "lf-ak3-002",
      "niva": "ak3",
      "typ": "ordning",
      "text": "Bo, Mira och Tor delar på uppgifterna. Bo bakar, Mira hämtar vatten och Tor tänder elden. När maten är klar sätter de sig i en ring. De turas om att berätta korta sagor. Natten blir lugn.",
      "fraga": "Vad händer efter att maten är klar?",
      "ratt": "De sätter sig i en ring",
      "fel": [
        "Mira hämtar vatten",
        "Bo bakar",
        "Tor tänder elden"
      ]
    },
    {
      "id": "lf-ak3-003",
      "niva": "ak3",
      "typ": "vem",
      "text": "En rävunge har tappat bort sin mamma. Den snusar längs stigen och hittar doften av rök. Vid lägret får den en bit bröd av barnen. Mamma-räven dyker upp strax efter. De lämnar lägret tillsammans.",
      "fraga": "Vem ger rävungen bröd?",
      "ratt": "Barnen",
      "fel": [
        "Ugglan",
        "Mamma-räven",
        "Tor ensam"
      ]
    },
    {
      "id": "lf-ak3-004",
      "niva": "ak3",
      "typ": "varfor",
      "text": "Skymningen kommer snabbt mellan granarna. Tor tänder lyktan så att stigen syns. Vinden tar i och kapperna fladdrar. De håller i varandra för att inte tappa bort någon. Snart syns byns ljus.",
      "fraga": "Varför tänder Tor lyktan?",
      "ratt": "Så att stigen syns",
      "fel": [
        "För att skrämma djur",
        "För att laga mat",
        "För att sova"
      ]
    },
    {
      "id": "lf-ak3-005",
      "niva": "ak3",
      "typ": "var",
      "text": "Gläntan öppnar sig som ett litet rum i skogen. Solen når marken och värmer stenarna. Blommor växer runt en stubbe där en älva vilar. Älvan ger barnen en fjäder som tack. De lovar att vårda platsen.",
      "fraga": "Var vilar älvan?",
      "ratt": "På stubben i gläntan",
      "fel": [
        "I båten",
        "På byns tak",
        "I snön"
      ]
    },
    {
      "id": "lf-ak3-006",
      "niva": "ak3",
      "typ": "slutsats",
      "text": "Hugo har vandrat från gryning till skymning. Fötterna värker och ryggsäcken känns tung. Han sätter sig vid en varm sten i solen. Ögonlocken blir tunga. Snart sover han en kort stund.",
      "fraga": "Varför somnar Hugo?",
      "ratt": "Han är uttröttad efter vandringen",
      "fel": [
        "Han är arg på vännerna",
        "Han fryser av snö",
        "Han är hungrig på fisk"
      ]
    },
    {
      "id": "lf-ak3-007",
      "niva": "ak3",
      "typ": "ord",
      "text": "Ordet blekna betyder att färgen eller ljuset blir svagare. Himlen bleknar när solen går ner. Runans sken bleknar också när molnen kommer. Då tänder vandrarna sina lyktor.",
      "fraga": "Vad betyder blekna?",
      "ratt": "Bli svagare i färg eller ljus",
      "fel": [
        "Bli tyngre",
        "Bli högre",
        "Bli snabbare"
      ]
    },
    {
      "id": "lf-ak3-008",
      "niva": "ak3",
      "typ": "vad",
      "text": "Siv bär en kruka med honung över den smala bron. Hon går sakta för att inte spilla. En droppe faller i ån och fiskarna nyfiket tittar upp. På andra sidan väntar byborna. De ska baka sötbröd till festen.",
      "fraga": "Vad ska byborna baka?",
      "ratt": "Sötbröd",
      "fel": [
        "Knäckebröd utan smak",
        "Bara fisk",
        "En sten"
      ]
    },
    {
      "id": "lf-ak3-009",
      "niva": "ak3",
      "typ": "ordning",
      "text": "Först ritar de kartan på bark. Sen märker de stigen med blå stenar. Därefter går de tillbaka samma väg för att kontrollera märkena. När allt stämmer visar de kartan för de andra i lägret. Sist lägger de undan barken torrt.",
      "fraga": "Vad gör de precis innan de visar kartan?",
      "ratt": "Kontrollerar märkena på vägen tillbaka",
      "fel": [
        "Sover",
        "Lägger undan barken",
        "Ritar kartan"
      ]
    },
    {
      "id": "lf-ak3-010",
      "niva": "ak3",
      "typ": "slutsats",
      "text": "Älgen står stilla i morgondimman. Den vänder örat mot ett knak i busken. Barnen håller andan bakom en gran. Älgen bestämmer sig för att gå vidare. Dimman sluter sig om den.",
      "fraga": "Varför håller barnen andan?",
      "ratt": "De vill inte skrämma älgen",
      "fel": [
        "De är hungriga",
        "De ska sjunga",
        "De fryser"
      ]
    },
    {
      "id": "lf-ak3-011",
      "niva": "ak3",
      "typ": "var",
      "text": "Byarna klättrar längs fjällsidan. Röken från skorstenarna syns långt. En slingrande stig leder till en utsiktsplats. Därifrån ser man både ån och skogen. Många vandrare stannar där en stund.",
      "fraga": "Varifrån ser man både ån och skogen?",
      "ratt": "Från utsiktsplatsen",
      "fel": [
        "Från båten",
        "Från källaren",
        "Från grottan"
      ]
    },
    {
      "id": "lf-ak3-012",
      "niva": "ak3",
      "typ": "varfor",
      "text": "Alva övar runtecknen i sanden vid stranden. Hon skriver tre tecken och går bakåt för att se dem. En våg sveper in och suddar ut allt. Alva skrattar och börjar om. Hon säger att övning är viktigare än perfekta tecken.",
      "fraga": "Varför börjar Alva om?",
      "ratt": "Vågen suddade ut tecknen",
      "fel": [
        "Hon är arg",
        "Hon är hungrig",
        "Hon ska simma"
      ]
    },
    {
      "id": "lf-ak3-013",
      "niva": "ak3",
      "typ": "vad",
      "text": "Nisse hittar en gammal nyckel under en rot. Den passar i en liten låda gömd i stubben. I lådan ligger en vit fjäder och en lapp. Lappen säger: ge fjädern till den som hjälper dig. Nisse stoppar fjädern säkert undan.",
      "fraga": "Vad säger lappen att Nisse ska göra?",
      "ratt": "Ge fjädern till den som hjälper honom",
      "fel": [
        "Kasta fjädern i ån",
        "Gömma nyckeln igen",
        "Äta fjädern"
      ]
    },
    {
      "id": "lf-ak3-014",
      "niva": "ak3",
      "typ": "ord",
      "text": "Ordet slingrande betyder att något går i mjuka bågar. Stigen är slingrande mellan stenarna. Den tar längre tid än en rak väg. Men den är säkrare när det är brant.",
      "fraga": "Vad betyder slingrande?",
      "ratt": "Gående i mjuka bågar",
      "fel": [
        "Gående baklänges",
        "Gående rakt",
        "Gående under jorden"
      ]
    },
    {
      "id": "lf-ak3-015",
      "niva": "ak3",
      "typ": "vem",
      "text": "Harald ger hästen vatten och borstar manen. Hästen står stilla och litar på honom. Sen lastar de ryggsäckarna. De går i jämn takt längs ån. Ingen lämnas efter.",
      "fraga": "Vem litar hästen på?",
      "ratt": "Harald",
      "fel": [
        "Björnen",
        "Ugglan",
        "Månen"
      ]
    },
    {
      "id": "lf-ak3-016",
      "niva": "ak3",
      "typ": "varfor",
      "text": "Regnet kommer plötsligt. De sätter upp tältet mellan två granar. Elden skyddas med en ring av stenar. Kapperna hängs att torka. Inne i tältet blir det snart varmt.",
      "fraga": "Varför sätter de upp tältet?",
      "ratt": "Det börjar regna",
      "fel": [
        "De ska fiska",
        "Det är soligt",
        "De ska dansa"
      ]
    },
    {
      "id": "lf-ak3-017",
      "niva": "ak3",
      "typ": "ordning",
      "text": "Först samlar de blåbär i korgar. Sen kokar de dem sakta till sylt. Därefter fyller de rena burkar. Burkarna märks med namn och dag. Sist ställs de svalt i skafferiet.",
      "fraga": "Vad gör de efter att sylten kokat?",
      "ratt": "Fyller rena burkar",
      "fel": [
        "Ställer burkar svalt",
        "Äter upp allt",
        "Samlar blåbär"
      ]
    },
    {
      "id": "lf-ak3-018",
      "niva": "ak3",
      "typ": "slutsats",
      "text": "Månen speglas blank i sjön. Vinden är nästan stilla. En uggla ropar långt bort. Lägret har bara en liten eld. Natten känns trygg och stor.",
      "fraga": "Hur beskrivs natten?",
      "ratt": "Trygg och stor",
      "fel": [
        "Högljudd och het",
        "Tom och arg",
        "Läskig och kall"
      ]
    },
    {
      "id": "lf-ak3-019",
      "niva": "ak3",
      "typ": "var",
      "text": "Ida följer små spår i snön. Spåren leder till en håla under en rot. Därinne sover en björnunge med runda öron. Ida backar tyst. Hon berättar senare för de andra utan att störa ungen.",
      "fraga": "Var sover björnungen?",
      "ratt": "I en håla under en rot",
      "fel": [
        "På byns tak",
        "I båten",
        "I trädet"
      ]
    },
    {
      "id": "lf-ak3-020",
      "niva": "ak3",
      "typ": "vad",
      "text": "Tor berättar en saga om en runa som visade vägen. Alla lyssnar nära elden. När sagan tar slut är det tyst en stund. Sen ställer barnen frågor. Tor svarar lugnt.",
      "fraga": "Vad handlar sagan om?",
      "ratt": "En runa som visade vägen",
      "fel": [
        "En hatt som sjöng",
        "En sten som åt",
        "En fisk som flög"
      ]
    },
    {
      "id": "lf-ak3-021",
      "niva": "ak3",
      "typ": "ord",
      "text": "Ordet svalt betyder svalare än vanligt rum, men inte isande kallt. Sylten håller sig bättre svalt. Därför ställs burkarna i skafferiet. Solen når inte dit.",
      "fraga": "Vad betyder svalt?",
      "ratt": "Lite kallt men inte isande",
      "fel": [
        "Mycket mörkt",
        "Mycket blött",
        "Mycket hett"
      ]
    },
    {
      "id": "lf-ak3-022",
      "niva": "ak3",
      "typ": "vem",
      "text": "Mira och Bo leker kull mellan björkarna. Bo tappar hatten när han svänger. Mira plockar upp den och ger tillbaka den. De skrattar och fortsätter. Ingen blir sur.",
      "fraga": "Vem tappar hatten?",
      "ratt": "Bo",
      "fel": [
        "Tor",
        "Mira",
        "Älvan"
      ]
    },
    {
      "id": "lf-ak3-023",
      "niva": "ak3",
      "typ": "varfor",
      "text": "Efter regnet är stigen lerig och halt. De går sakta och håller i varandra. Ingen vill halka ner i diket. När de når stenbron andas de ut. Bron är torrare.",
      "fraga": "Varför går de sakta?",
      "ratt": "Stigen är lerig och halt",
      "fel": [
        "De är hungriga",
        "Stigen är torr",
        "De ska sova"
      ]
    },
    {
      "id": "lf-ak3-024",
      "niva": "ak3",
      "typ": "ordning",
      "text": "Först öppnar de den låga porten. Sen går de in i gården där en hund viftar på svansen. De hälsar på husfolket. Sist får de varm soppa vid bordet. Det känns som hemma.",
      "fraga": "Vad händer precis innan de får soppa?",
      "ratt": "De hälsar på husfolket",
      "fel": [
        "Går in i gården",
        "Sover",
        "Öppnar porten"
      ]
    },
    {
      "id": "lf-ak3-025",
      "niva": "ak3",
      "typ": "slutsats",
      "text": "Fåglarna samlas på ledstänger och tak. Det börjar bli kallt om nätterna. Löven faller i gula högar. Vinden tar från norr. Allt tyder på att vintern snart är här.",
      "fraga": "Vilken årstid närmar sig enligt texten?",
      "ratt": "Vintern",
      "fel": [
        "Högsommar",
        "Sommaren",
        "Våren"
      ]
    },
    {
      "id": "lf-ak3-026",
      "niva": "ak3",
      "typ": "vad",
      "text": "Siv lägger blå stenar längs stigen. Stenarna visar vägen tillbaka till lägret. Andra vandrare kan följa dem även i skymning. En sten är större och markerar vägskälet. Där skiljs två stigar.",
      "fraga": "Vad markerar den större stenen?",
      "ratt": "Vägskälet",
      "fel": [
        "Ån",
        "Månen",
        "Taket"
      ]
    },
    {
      "id": "lf-ak3-027",
      "niva": "ak3",
      "typ": "var",
      "text": "Ån sväller efter flera dagars regn. Bron darrar när de går över. De går en i taget och håller i räcket. På andra sidan väntar torr mark. Alla andas ut.",
      "fraga": "Var går de en i taget?",
      "ratt": "Över bron",
      "fel": [
        "I skogen",
        "I båten",
        "På taket"
      ]
    },
    {
      "id": "lf-ak3-028",
      "niva": "ak3",
      "typ": "ord",
      "text": "Ordet darrar betyder att något skakar smått. Bron darrar under fötterna. Det känns i benen. Därför går de försiktigt.",
      "fraga": "Vad betyder darrar?",
      "ratt": "Skakar smått",
      "fel": [
        "Sjunger högt",
        "Lyser starkt",
        "Luktar gott"
      ]
    },
    {
      "id": "lf-ak3-029",
      "niva": "ak3",
      "typ": "slutsats",
      "text": "Elin delar sitt sista bröd med den hungriga räven. Räven tar emot det och sätter sig en bit bort. Elin ler utan att gå närmare. De skiljs utan rädsla. Skogen känns vänligare efteråt.",
      "fraga": "Hur förändras känslan i skogen?",
      "ratt": "Den känns vänligare",
      "fel": [
        "Den försvinner",
        "Den blir tyst av ilska",
        "Den känns läskigare"
      ]
    },
    {
      "id": "lf-ak3-030",
      "niva": "ak3",
      "typ": "vad",
      "text": "Hugo räknar stjärnor och kommer till tio innan ögonen faller igen. Drömmen är ljus och varm. Han vaknar när gryningen kommer. Dagg ligger på tältet. Det luktar rök från den nya elden.",
      "fraga": "Hur långt räknar Hugo innan han somnar?",
      "ratt": "Till tio",
      "fel": [
        "Till hundra",
        "Till två",
        "Till noll"
      ]
    },
    {
      "id": "lf-ak3-031",
      "niva": "ak3",
      "typ": "var",
      "text": "Byborna samlas vid den stora elden varje lördag. De delar nyheter och små gåvor. Barnen lyssnar tills de somnar mot någons axel. Kvällen blir lång men trygg. Ingen behöver gå hem ensam i mörkret.",
      "fraga": "Var samlas byborna på lördagar?",
      "ratt": "Vid den stora elden",
      "fel": [
        "I sjön",
        "På taket",
        "I grottan"
      ]
    },
    {
      "id": "lf-ak3-032",
      "niva": "ak3",
      "typ": "varfor",
      "text": "Snön faller tätare och tätare. De skyndar mot stugan längst in i dalen. Inne brinner redan en eld. Utanför vitnar stigar och tak. Världen blir tyst och mjuk.",
      "fraga": "Varför skyndar de till stugan?",
      "ratt": "Snön faller tätare",
      "fel": [
        "De ska simma",
        "Det är sommarhett",
        "De ska fiska"
      ]
    }
  ]
}
