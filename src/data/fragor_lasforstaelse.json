      "fraga": "Hur är byarna?",
      "ratt": "Lugna och sovande",
      "fel": [
        "Mitt i storm",
        "Fulla av fest",
        "Tomma på hus"
      ]
    },
    {
      "id": "lf-ak1-028",
      "niva": "ak1",
      "typ": "vad",
      "text": "Siv bär en korg. I korgen ligger ägg. Hon går försiktigt.",
      "fraga": "Vad ligger i korgen?",
      "ratt": "Ägg",
      "fel": [
        "Böcker",
        "Stenar",
        "Yxor"
      ]
    },
    {
      "id": "lf-ak1-029",
      "niva": "ak1",
      "typ": "var",
      "text": "Ån rinner genom dalen. Fiskar simmar där. Barnen sitter och tittar.",
      "fraga": "Var simmar fiskarna?",
      "ratt": "I ån",
      "fel": [
        "I elden",
        "I luften",
        "I snön"
      ]
    },
    {
      "id": "lf-ak1-030",
      "niva": "ak1",
      "typ": "ord",
      "text": "Ordet mjuk betyder inte hård. Fjädern är mjuk. Stenen är hård.",
      "fraga": "Vad betyder mjuk?",
      "ratt": "Inte hård",
      "fel": [
        "Mycket kall",
        "Mycket hög",
        "Mycket tung"
      ]
    },
    {
      "id": "lf-ak1-031",
      "niva": "ak1",
      "typ": "vem",
      "text": "Harald hjälper till. Han bär vatten. Alla tackar honom.",
      "fraga": "Vem hjälper till?",
